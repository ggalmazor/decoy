{
  "name": "DECOY — redacted-dossier punk",
  "color": {
    "manila": { "value": "#E8DCC2", "use": "page ground" },
    "paper": { "value": "#F6F1E6", "use": "documents, side panel, cards on dark bands" },
    "paperBright": { "value": "#FFFCF4", "use": "mood cards, inputs, export preview page" },
    "backdrop": { "value": "#5A5246", "use": "behind modal dialogs" },
    "ink": { "value": "#17140F", "use": "text, 2px borders, dark bands, primary buttons" },
    "ink2": { "value": "#2E2922", "use": "body copy on light grounds" },
    "ink3": { "value": "#3F392F", "use": "captions, small uppercase labels" },
    "onDark": { "value": "#F6F1E6", "use": "text on ink" },
    "onDark2": { "value": "#E3DACA", "use": "secondary text on ink" },
    "rule": { "value": "#B7AD9C", "use": "1px borders on secondary buttons and list items" },
    "ruleSoft": { "value": "#DCD2BF", "use": "row dividers, meter track" },
    "accent": { "value": "#C8231B", "use": "the only accent: primary CTA shadow, Export, selection, stamps, badges, step numbers" },
    "accentHover": { "value": "#9E1912", "use": "link hover" },
    "onAccent": { "value": "#FFFFFF", "use": "text on accent" }
  },
  "font": {
    "display": { "family": "Anton", "weights": [400], "use": "UPPERCASE headings, stamps, big numbers, logo wordmark" },
    "ui": { "family": "IBM Plex Mono", "weights": [400, 500, 600], "use": "all UI and body copy" },
    "doc": { "family": "Courier Prime", "weights": [400, 700], "use": "document text in mockups, decoy text, decoy rasterisation (700)" }
  },
  "type": {
    "label": "11–12px Plex Mono 600, uppercase, letter-spacing .12em",
    "small": "13px",
    "base": "14px (app) / 16px (landing)",
    "lead": "18px, line-height 1.6",
    "cardTitle": "30px Anton",
    "dialogTitle": "44px Anton",
    "section": "clamp(44px, 5.6vw, 78px) Anton, line-height .98",
    "hero": "clamp(64px, 7.6vw, 112px) Anton, line-height .92"
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 104],
  "radius": 0,
  "border": "2px solid ink (primary), 1px solid rule (secondary)",
  "shadow": {
    "button": "4px 4px 0 accent",
    "paper": "14px 16px 0 rgba(23,20,15,.14)",
    "dialog": "16px 18px 0 rgba(23,20,15,.35)"
  },
  "texture": "repeating-linear-gradient(0deg, rgba(23,20,15,.035) 0 1px, transparent 1px 4px) on manila",
  "layout": { "contentMax": 1240, "gutter": "clamp(16px, 4vw, 32px)", "touchTarget": 44 },
  "mosaic": { "font": "700 Courier Prime", "fontSize": "0.82 × box height", "defaultCell": 8, "jitter": 0.06, "maxDarkness": 0.9 }
}
