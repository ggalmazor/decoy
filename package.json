{
  "name": "decoy",
  "version": "0.1.0",
  "private": true,
  "description": "Client-side redaction that paints a pixelated decoy phrase over the secret instead of pixelating the secret.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://decoy.ggalmazor.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggalmazor/decoy.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
