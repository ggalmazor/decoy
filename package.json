{
  "name": "@ggalmazor/decoy",
  "version": "1.3.0",
  "description": "Redaction that paints a pixelated decoy phrase over the secret instead of pixelating the secret. Web app, CLI, and MCP server; everything runs on your machine.",
  "keywords": [
    "redaction",
    "pdf",
    "pixelation",
    "privacy",
    "mcp",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://decoy.ggalmazor.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggalmazor/decoy.git"
  },
  "bin": {
    "decoy": "dist-cli/decoy.mjs"
  },
  "files": [
    "dist-cli",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:cli && npm run test:e2e",
    "build:cli": "vite build -c vite.cli.config.ts",
    "cli": "node dist-cli/decoy.mjs",
    "prepack": "npm run build:cli"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.11",
    "@preact/signals": "^2.11.3",
    "commander": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "preact": "^11.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
